# Copia este archivo como ".env" y completa los valores reales ahí.
# El archivo ".env" nunca se sube al repositorio (ya está excluido en .gitignore).

# Llave de API de Gemini
GEMINI_API_KEY=tu_llave_aqui

# Modelo predeterminado elegido en docs/decision-arquitectura.md
GEMINI_MODEL=gemini-3.5-flash-lite

# Si cambias GEMINI_MODEL para el cliente del Módulo 2, define ambas tarifas
# del modelo elegido en USD por millón de tokens:
# GEMINI_PRECIO_ENTRADA_POR_MILLON=0.30
# GEMINI_PRECIO_SALIDA_POR_MILLON=2.50
